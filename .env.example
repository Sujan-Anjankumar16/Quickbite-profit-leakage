# Copy to .env and change the values.  .env is never committed.
MYSQL_ROOT_PASSWORD=change_me_root

# One MySQL login per role (created by db/mysql/02_roles.sql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quickbite
DB_ADMIN_USER=qb_admin_user
DB_ADMIN_PASSWORD=Admin@Dev123
DB_ANALYST_USER=qb_analyst_user
DB_ANALYST_PASSWORD=Analyst@Dev123
DB_VIEWER_USER=qb_viewer_user
DB_VIEWER_PASSWORD=Viewer@Dev123

MONGO_URL=mongodb://localhost:27017/quickbite
REDIS_URL=redis://localhost:6379

# Used to sign login sessions (Step 8). Any long random string.
AUTH_SECRET=replace_with_a_long_random_string
